[Unit]
Description=keepalive-mover - Prevent idle/away status in Discord and other apps
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/rasrobo/keepalive-mover/main.py --interval 45 --idle-threshold 120 --pixels 1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment for X11/Wayland
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/keepalive-mover

[Install]
WantedBy=default.target